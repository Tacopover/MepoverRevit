<Window x:Class="ClashDetectorUI.ClashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClashDetectorUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <ResourceDictionary Source="Styles\StylesTotal.xaml"/>
    </Window.Resources>
    <Grid>
        <TextBlock Text="{Binding Result}" d:Text="Text here" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Button Content="Click me!" VerticalAlignment="Bottom" HorizontalAlignment="Center" Click="Button_Click" />
    </Grid>
</Window>
