<Window x:Class="ClashDetectorUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClashDetectorUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Text="{Binding Test}" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Button Content="Click me!" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
    </Grid>
</Window>
