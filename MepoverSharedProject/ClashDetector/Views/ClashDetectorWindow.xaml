<Window
    x:Class="ClashDetector.Views.ClashDetectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClashDetector.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    MinWidth="600"
    MinHeight="300"
    MaxWidth="800"
    MaxHeight="500"
    AllowsTransparency="True"
    Background="Transparent"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\Styles\StylesTotal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        Background="White"
        BorderBrush="CornflowerBlue"
        BorderThickness="1"
        CornerRadius="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- ═══ Title bar ═══ -->
            <Border
                Grid.Row="0"
                BorderBrush="#DDEAFF"
                BorderThickness="0,0,0,1">
                <Border
                    CornerRadius="3"
                    BorderBrush="CornflowerBlue"
                    BorderThickness="2"
                    Width="150"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="Clash Detector"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="13"
                        FontWeight="Bold"/>
                </Border>
            </Border>

            <!-- Window chrome buttons -->
            <StackPanel
                Grid.Row="0"
                Margin="0,0,6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="ButtonMinimize"
                    Width="24" Height="24"
                    Background="Transparent" BorderBrush="Transparent"
                    Style="{StaticResource ButtonStyleMenubar}"
                    Click="ButtonMinimize_Click">
                    <iconPacks:PackIconMaterial Width="9" Height="9" Margin="0,4,0,0" Kind="Minus"/>
                </Button>
                <Button
                    x:Name="ButtonMaximize"
                    Width="24" Height="24"
                    Background="Transparent" BorderBrush="Transparent"
                    Style="{StaticResource ButtonStyleMenubar}"
                    Click="ButtonMaximize_Click">
                    <iconPacks:PackIconMaterial Width="9" Height="9" Kind="CheckboxBlankOutline"/>
                </Button>
                <Button
                    x:Name="ButtonClose"
                    Width="24" Height="24"
                    Background="Transparent" BorderBrush="Transparent"
                    Style="{StaticResource ButtonStyleClose}"
                    Click="ButtonClose_Click">
                    <iconPacks:PackIconMaterial x:Name="closeIcon" Width="9" Height="9" Kind="Close"/>
                </Button>
            </StackPanel>

            <!-- ═══ Info text ═══ -->
            <Border
                Grid.Row="1"
                Background="#F0F5FF"
                BorderBrush="#DDEAFF"
                BorderThickness="0,0,0,1"
                Padding="12,8">
                <TextBlock
                    FontSize="11"
                    Foreground="#555577"
                    TextWrapping="Wrap"
                    Text="Elements visible in the currently active view will be checked for clashes. Select a model on each side (A and B) below, then press Clash."/>
            </Border>

            <!-- ═══ Content area (model selection) ═══ -->
            <ContentControl
                Grid.Row="2"
                Margin="6,6,6,0"
                Content="{Binding SelectedViewModel}"/>

            <!-- ═══ Footer ═══ -->
            <Border
                Grid.Row="3"
                BorderBrush="#DDEAFF"
                BorderThickness="0,1,0,0"
                Background="#F5F7FF">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontStyle="Italic"
                        FontSize="11"
                        Foreground="#888888"
                        TextTrimming="CharacterEllipsis"
                        Text="{Binding StatusMessage}"/>
                    <Button
                        Grid.Column="1"
                        Height="32"
                        Width="76"
                        VerticalAlignment="Center"
                        Command="{Binding RunCommand}"
                        Content="Clash"
                        Style="{StaticResource FlatButton}"/>
                </Grid>
            </Border>

        </Grid>
    </Border>

</Window>
