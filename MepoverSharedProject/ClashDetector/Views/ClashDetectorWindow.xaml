<Window
    x:Class="ClashDetector.Views.ClashDetectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClashDetector.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    MinWidth="600"
    MinHeight="300"
    MaxWidth="800"
    MaxHeight="500"
    AllowsTransparency="True"
    Background="Transparent"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\Styles\StylesTotal.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                NavButton — modern sidebar nav button.
                Tag="Selected" (set via DataTrigger below) drives the accent indicator.
                Trigger order: hover first, then selected (later = higher precedence when both active).
            -->
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#444444"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Bg" Background="{TemplateBinding Background}"/>
                                <Rectangle x:Name="Indicator"
                                           Width="3"
                                           HorizontalAlignment="Left"
                                           Fill="CornflowerBlue"
                                           Opacity="0"/>
                                <ContentPresenter
                                    Margin="16,0,8,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#F0F4FF"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="Bg" Property="Background" Value="#EEF2FF"/>
                                    <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                    <Setter Property="Foreground" Value="CornflowerBlue"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#DCE8FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        Background="White"
        BorderBrush="CornflowerBlue"
        BorderThickness="1"
        CornerRadius="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- ═══ Title bar ═══ -->
            <Border
                Grid.Row="0"
                Grid.ColumnSpan="2"
                BorderBrush="#DDEAFF"
                BorderThickness="0,0,0,1">
                <Border
                    CornerRadius="3"
                    BorderBrush="CornflowerBlue"
                    BorderThickness="2"
                    Width="150"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="Clash Detector"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="13"
                        FontWeight="Bold"/>
                </Border>
            </Border>

            <!-- Window chrome buttons -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="ButtonMinimize"
                    Width="24" Height="24"
                    Background="Transparent" BorderBrush="Transparent"
                    Style="{StaticResource ButtonStyleMenubar}"
                    Click="ButtonMinimize_Click">
                    <iconPacks:PackIconMaterial Width="9" Height="9" Margin="0,4,0,0" Kind="Minus"/>
                </Button>
                <Button
                    x:Name="ButtonMaximize"
                    Width="24" Height="24"
                    Background="Transparent" BorderBrush="Transparent"
                    Style="{StaticResource ButtonStyleMenubar}"
                    Click="ButtonMaximize_Click">
                    <iconPacks:PackIconMaterial Width="9" Height="9" Kind="CheckboxBlankOutline"/>
                </Button>
                <Button
                    x:Name="ButtonClose"
                    Width="24" Height="24"
                    Background="Transparent" BorderBrush="Transparent"
                    Style="{StaticResource ButtonStyleClose}"
                    Click="ButtonClose_Click">
                    <iconPacks:PackIconMaterial x:Name="closeIcon" Width="9" Height="9" Kind="Close"/>
                </Button>
            </StackPanel>

            <!-- ═══ Sidebar ═══ -->
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Background="#F5F7FF"
                BorderBrush="#DDEAFF"
                BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8,0,0">

                    <Button
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Models"
                        Content="Models">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedButton}" Value="Models">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Categories"
                        Content="Categories">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedButton}" Value="Categories">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Worksets"
                        Content="Worksets">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedButton}" Value="Worksets">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Border>

            <!-- ═══ Content area ═══ -->
            <ContentControl
                Grid.Row="1"
                Grid.Column="1"
                Margin="6,6,6,0"
                Content="{Binding SelectedViewModel}"/>

            <!-- ═══ Footer ═══ -->
            <Border
                Grid.Row="2"
                Grid.ColumnSpan="2"
                BorderBrush="#DDEAFF"
                BorderThickness="0,1,0,0"
                Background="#F5F7FF">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontStyle="Italic"
                        FontSize="11"
                        Foreground="#888888"
                        TextTrimming="CharacterEllipsis"
                        Text="{Binding StatusMessage}"/>
                    <Button
                        Grid.Column="1"
                        Height="32"
                        Width="76"
                        VerticalAlignment="Center"
                        Command="{Binding RunCommand}"
                        Content="Clash"
                        Style="{StaticResource FlatButton}"/>
                </Grid>
            </Border>

        </Grid>
    </Border>

</Window>
