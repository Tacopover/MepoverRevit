<Window
    x:Class="ClashDetector.Views.ClashDetectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClashDetector.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    MinWidth="600"
    MinHeight="300"
    MaxWidth="800"
    MaxHeight="500"
    AllowsTransparency="True"
    Background="Transparent"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <!--<ResourceDictionary Source="pack://application:,,,/MepoverSharedProject;component/Styles/StylesTotal.xaml"/>-->
        <ResourceDictionary Source="..\..\Styles\StylesTotal.xaml"/>
    </Window.Resources>

    <Border
        Background="White"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="5">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <ToggleButton
                    x:Name="ButtonMinimize"
                    Width="24"
                    Height="24"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="ButtonMinimize_Click">
                    <iconPacks:PackIconMaterial
                        Width="10"
                        Height="10"
                        Margin="0,8,0,0"
                        Kind="Minus" />
                </ToggleButton>

                <ToggleButton
                    x:Name="ButtonMaximize"
                    Width="24"
                    Height="24"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="ButtonMaximize_Click">
                    <iconPacks:PackIconMaterial
                        Width="10"
                        Height="10"
                        Kind="CheckboxBlankOutline" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ButtonClose"
                    Width="24"
                    Height="24"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="ButtonClose_Click">
                    <iconPacks:PackIconMaterial
                        x:Name="closeIcon"
                        Width="10"
                        Height="10"
                        Kind="Close" />
                </ToggleButton>
            </StackPanel>

            <TextBlock
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="15,0"
                HorizontalAlignment="Left"
                FontSize="16"
                FontWeight="Bold"
                Foreground="Black"
                Text="Clash Detector" />


            <StackPanel Grid.Row="1">

                <Button
                    Height="35"
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="Models"
                    Content="Models"
                    Style="{StaticResource SideBarButton}" />



                <Button
                    Height="35"
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="Categories"
                    Content="Categories"
                    Style="{StaticResource SideBarButton}" />


                <Button
                    Height="35"
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="Worksets"
                    Content="Worksets"
                    Style="{StaticResource SideBarButton}" />



            </StackPanel>

            <ContentControl
                Grid.Row="1"
                Grid.Column="1"
                Content="{Binding SelectedViewModel}" />

            <Button
                Grid.Row="2"
                Grid.Column="1"
                Height="30"
                Width="70"
                Command="{Binding RunCommand}"
                Content="Clash"
                HorizontalAlignment="Right"
                Margin="0,0,5,0"
                 />

        </Grid>
    </Border>

</Window>
