<UserControl
    x:Class="ClashDetector.Views.CategoriesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClashDetector.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="400"
    d:Background="White">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" Grid.ColumnSpan="2">

            <TextBlock Text="If enabled the categories A from models A will be clashed against the categories B from models B. If disabled all categories will be clashed against each other." 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" 
                       Grid.ColumnSpan="2" 
                       VerticalAlignment="Top" FontStyle="Italic" FontSize="12"/>

            <ToggleButton HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="10,5"
                          Width="50" 
                          Height="24" 
                          BorderBrush="Transparent"
                          Content="Enable"
                          IsChecked="{Binding ClashSettings.IsCategoriesEnabled}"/>
        </StackPanel>
                    
        
        

            <TextBlock Text="Categories A:" 
                       HorizontalAlignment="Left" 
                       Margin="10,0,0,0" 
                       VerticalAlignment="Bottom" 
                       FontSize="18" 
                       FontWeight="Bold"/>

        <TextBlock Text="Categories B:" 
                       Grid.Column="1"
                       HorizontalAlignment="Left" 
                       Margin="10,0,0,0" 
                       VerticalAlignment="Bottom" 
                       FontSize="18" 
                       FontWeight="Bold"/>

        <ListBox Margin="10" 
                 Grid.Column="0" 
                 Grid.Row="1" 
                 ItemsSource="{Binding ClashSettings.Categories1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 SelectionMode="Multiple"
                 IsEnabled="{Binding ClashSettings.IsCategoriesEnabled}">
            <ListBox.Resources>
                <!--<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource VMScrollBar}">
                    <Setter Property="Orientation" Value="Vertical"/>
                </Style>-->
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <CheckBox Content="{Binding Name}" 
                                  Margin="5,2" 
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <!--<ContentPresenter/>-->
                                </CheckBox>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
        </ListBox>

        <ListBox Margin="10" 
                 Grid.Column="1" 
                 Grid.Row="1" 
                 ItemsSource="{Binding ClashSettings.Categories2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 SelectionMode="Multiple"
                 IsEnabled="{Binding ClashSettings.IsCategoriesEnabled}">
            <ListBox.Resources>
                <!--<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource VMScrollBar}">
                    <Setter Property="Orientation" Value="Vertical"/>
                </Style>-->
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <CheckBox Content="{Binding Name}" 
                                  Margin="5,2" 
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <!--<ContentPresenter/>-->
                                </CheckBox>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
        </ListBox>

    </Grid>
</UserControl>
