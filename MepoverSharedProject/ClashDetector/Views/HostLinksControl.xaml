<UserControl
    x:Class="ClashDetector.Views.HostLinksControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClashDetector.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="500"
    d:DesignWidth="700"
    d:Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Models A" 
           ToolTip="Select group A models to clash with group B models"
           HorizontalAlignment="Left" 
           VerticalAlignment="Bottom"
           Margin="10,0,0,0"
           FontSize="18" FontWeight="Bold"/>

        <ListBox 
            Margin="10" 
            Grid.Column="0" 
            Grid.Row="1" 
            ItemsSource="{Binding ClashSettings.RevitModels1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
            SelectionMode="Multiple">
            <ListBox.Resources>
                <!--<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource VMScrollBar}">
                    <Setter Property="Orientation" Value="Vertical"/>
                </Style>-->
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <CheckBox Content="{Binding Name}" 
                                  Margin="5,2" 
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <!--<ContentPresenter/>-->
                                </CheckBox>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
        </ListBox>

        <TextBlock Text="Models B" 
            ToolTip="Select group B models to clash with group A models"
            HorizontalAlignment="Left" 
            Grid.Column="1"
            VerticalAlignment="Bottom"
            Margin="10,0,0,0"
            FontSize="18" FontWeight="Bold"/>

        <ListBox 
            Margin="10" 
            Grid.Column="1" 
            Grid.Row="1" 
            ItemsSource="{Binding ClashSettings.RevitModels2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
            SelectionMode="Multiple">
            <ListBox.Resources>
                <!--<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource VMScrollBar}">
            <Setter Property="Orientation" Value="Vertical"/>
        </Style>-->
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <CheckBox Content="{Binding Name}" 
                          Margin="5,2" 
                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <!--<ContentPresenter/>-->
                                </CheckBox>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
        </ListBox>

    </Grid>
</UserControl>
