<Window x:Class="IfcExport.IfcExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IFC Export" Height="300" Width="500"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary Source="..\Styles\StylesTotal.xaml"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="5" BorderThickness="1" BorderBrush="CornflowerBlue">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" CornerRadius="2" BorderBrush="CornflowerBlue" Width="150" Height="30"
                    BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                <TextBlock Text="IFC Export" HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/>
            </Border>
            <Button x:Name="ButtonMinimize" Grid.Row="0" Width="24" Height="24" BorderBrush="Transparent"
                    Style="{StaticResource FlatButton}" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,38,0"
                    Click="ButtonMinimize_Click">
                <Rectangle Width="12" Height="2" Fill="White"/>
            </Button>
            <Button x:Name="ButtonClose" Grid.Row="0" Width="24" Height="24" BorderBrush="Transparent"
                    Style="{StaticResource ButtonStyleClose}" Background="Transparent" Content="&#x2715;"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,10,0"
                    Click="ButtonClose_Click"/>

            <!-- Settings -->
            <GroupBox Grid.Row="1" Header="Settings" Margin="10,5,10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IFC Version:" VerticalAlignment="Center" Margin="5,0"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                              ItemsSource="{Binding IfcVersions}"
                              SelectedItem="{Binding SelectedIfcVersion}"
                              Margin="5,3" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Destination:" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" Margin="5,3"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="5,3"
                            Command="{Binding BrowseCommand}" Style="{StaticResource FlatButton}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pset file:" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding PsetMappingFilePath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" Margin="5,3" IsReadOnly="True"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Margin="5,3"
                            Command="{Binding BrowsePsetCommand}" Style="{StaticResource FlatButton}"/>
                </Grid>
            </GroupBox>

            <!-- Progress -->
            <GroupBox Grid.Row="2" Header="Progress" Margin="10,0,10,5">
                <StackPanel Margin="5">
                    <ProgressBar Height="16" Minimum="0"
                                 Maximum="{Binding ProgressMax}"
                                 Value="{Binding ProgressValue}" Margin="0,2,0,4"/>
                    <TextBlock Text="{Binding StatusText}" FontStyle="Italic"/>
                    <TextBlock Text="{Binding PendingChanges, StringFormat='Pending changes: {0}'}"
                               FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Controls -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="10,0,10,5">
                <Button Content="Run"    Command="{Binding RunCommand}"    Style="{StaticResource FlatButton}" Width="70" Margin="3,0"/>
                <Button Content="Pause"  Command="{Binding PauseCommand}"  Style="{StaticResource FlatButton}" Width="70" Margin="3,0"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource FlatButton}" Width="70" Margin="3,0"/>
            </StackPanel>

            <!-- Quick Export: bare-bones synchronous test, no task pump -->
            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="10,0,10,5">
                <Button Content="Quick Export (IFC2x3)" Command="{Binding QuickExportCommand}"
                        Style="{StaticResource FlatButton}" Width="160" Margin="3,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
