<common:ToolWindow
    x:Class="LevelChanger.Views.LevelChangerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:MepoverSharedProject.Common"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Width="460" Height="600" MinWidth="380" MinHeight="440"
    AllowsTransparency="True" Background="Transparent"
    WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip">

    <common:ToolWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\Styles\StylesTotal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </common:ToolWindow.Resources>

    <Border Background="White" BorderBrush="CornflowerBlue" BorderThickness="1" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="#DDEAFF" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border CornerRadius="3" BorderBrush="CornflowerBlue" BorderThickness="2"
                        Width="190" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Change Object Levels" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"/>
                </Border>
            </Border>
            <StackPanel Grid.Row="0" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Width="24" Height="24" Background="Transparent" BorderBrush="Transparent"
                        Style="{StaticResource ButtonStyleMenubar}" Click="ButtonMinimize_Click">
                    <iconPacks:PackIconMaterial Width="9" Height="9" Margin="0,4,0,0" Kind="Minus"/>
                </Button>
                <Button Width="24" Height="24" Background="Transparent" BorderBrush="Transparent"
                        Style="{StaticResource ButtonStyleClose}" Click="ButtonClose_Click">
                    <iconPacks:PackIconMaterial Width="9" Height="9" Kind="Close"/>
                </Button>
            </StackPanel>

            <!-- Scope + margin -->
            <StackPanel Grid.Row="1" Margin="12,8,12,4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Selection" GroupName="Scope" Margin="0,0,12,0"
                                 IsEnabled="{Binding CanUseSelection}" IsChecked="{Binding IsSelectionScope}"/>
                    <RadioButton Content="Entire model" GroupName="Scope"
                                 IsChecked="{Binding IsModelScope}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Margin (mm)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="80" Height="24" VerticalContentAlignment="Center"
                             Style="{StaticResource VMTextBox}"
                             Text="{Binding MarginText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>

            <!-- Levels -->
            <Border Grid.Row="2" Margin="12,4,12,4" BorderBrush="CornflowerBlue" BorderThickness="1" CornerRadius="3">
                <DataGrid ItemsSource="{Binding Levels}" AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          BorderThickness="0" Background="White" GridLinesVisibility="None"
                          RowHeaderWidth="0" HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#EDF2FB"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderBrush" Value="#DDEAFF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Level" Width="*" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="4,2">
                                        <TextBlock Text="{Binding Name}"/>
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Elevation (mm)" Binding="{Binding ElevationMm}" Width="120" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,0,12,6">
                <Button Content="Toggle all" Width="90" Height="26"
                        Style="{StaticResource SecondaryButton}" Command="{Binding ToggleAllCommand}"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="4" BorderBrush="#DDEAFF" BorderThickness="0,1,0,0" Background="#F5F7FF">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"
                               Foreground="#888888" TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusMessage}"/>
                    <Button Grid.Column="1" Width="76" Height="30" Margin="0,0,8,0" VerticalAlignment="Center"
                            Content="OK" Style="{StaticResource FlatButton}" Command="{Binding OkCommand}"/>
                    <Button Grid.Column="2" Width="70" Height="30" VerticalAlignment="Center"
                            Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</common:ToolWindow>
