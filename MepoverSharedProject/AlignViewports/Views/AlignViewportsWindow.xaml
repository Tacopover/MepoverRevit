<common:ToolWindow
    x:Class="AlignViewports.Views.AlignViewportsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:MepoverSharedProject.Common"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Width="560" Height="600" MinWidth="440" MinHeight="420"
    AllowsTransparency="True" Background="Transparent"
    WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip">

    <common:ToolWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\Styles\StylesTotal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </common:ToolWindow.Resources>

    <Border Background="White" BorderBrush="CornflowerBlue" BorderThickness="1" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="#DDEAFF" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border CornerRadius="3" BorderBrush="CornflowerBlue" BorderThickness="2"
                        Width="170" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Align Viewports" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"/>
                </Border>
            </Border>
            <StackPanel Grid.Row="0" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Width="24" Height="24" Background="Transparent" BorderBrush="Transparent"
                        Style="{StaticResource ButtonStyleMenubar}" Click="ButtonMinimize_Click">
                    <iconPacks:PackIconMaterial Width="9" Height="9" Margin="0,4,0,0" Kind="Minus"/>
                </Button>
                <Button Width="24" Height="24" Background="Transparent" BorderBrush="Transparent"
                        Style="{StaticResource ButtonStyleClose}" Click="ButtonClose_Click">
                    <iconPacks:PackIconMaterial Width="9" Height="9" Kind="Close"/>
                </Button>
            </StackPanel>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="12,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Parent sheet" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="1" Height="26"
                          ItemsSource="{Binding Sheets}"
                          DisplayMemberPath="Title"
                          SelectedItem="{Binding SelectedMaster}"/>

                <TextBlock Grid.Row="2" Text="Child sheets" FontWeight="Bold" Margin="0,12,0,4"/>
                <Grid Grid.Row="3" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Height="24" VerticalContentAlignment="Center"
                             Style="{StaticResource VMTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Grid.Column="1" Content="Ignore case" VerticalAlignment="Center" Margin="8,0,0,0"
                              IsChecked="{Binding IgnoreCase}"/>
                </Grid>

                <Border Grid.Row="4" BorderBrush="CornflowerBlue" BorderThickness="1" CornerRadius="3">
                    <ListBox ItemsSource="{Binding SlaveSheets}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected}" Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="#DDEAFF" BorderThickness="0,1,0,0" Background="#F5F7FF">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"
                               Foreground="#888888" TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusMessage}"/>
                    <Button Grid.Column="1" Width="76" Height="30" Margin="0,0,8,0" VerticalAlignment="Center"
                            Content="Apply" Style="{StaticResource FlatButton}" Command="{Binding ApplyCommand}"/>
                    <Button Grid.Column="2" Width="70" Height="30" VerticalAlignment="Center"
                            Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</common:ToolWindow>
