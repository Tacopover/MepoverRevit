<common:ToolWindow
    x:Class="SelectionFilter.Views.SelectionFilterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:MepoverSharedProject.Common"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Width="680" Height="600" MinWidth="560" MinHeight="440"
    AllowsTransparency="True" Background="Transparent"
    WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip">

    <common:ToolWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\Styles\StylesTotal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </common:ToolWindow.Resources>

    <Border Background="White" BorderBrush="CornflowerBlue" BorderThickness="1" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="#DDEAFF" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border CornerRadius="3" BorderBrush="CornflowerBlue" BorderThickness="2"
                        Width="160" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Selection Filter" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"/>
                </Border>
            </Border>
            <StackPanel Grid.Row="0" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Width="24" Height="24" Background="Transparent" BorderBrush="Transparent"
                        Style="{StaticResource ButtonStyleMenubar}" Click="ButtonMinimize_Click">
                    <iconPacks:PackIconMaterial Width="9" Height="9" Margin="0,4,0,0" Kind="Minus"/>
                </Button>
                <Button Width="24" Height="24" Background="Transparent" BorderBrush="Transparent"
                        Style="{StaticResource ButtonStyleClose}" Click="ButtonClose_Click">
                    <iconPacks:PackIconMaterial Width="9" Height="9" Kind="Close"/>
                </Button>
            </StackPanel>

            <!-- Filter inputs -->
            <Grid Grid.Row="1" Margin="12,10,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Parameter" FontWeight="Bold" Margin="0,0,6,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Operator" FontWeight="Bold" Margin="6,0,6,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Value" FontWeight="Bold" Margin="6,0,6,2"/>

                <ComboBox Grid.Row="1" Grid.Column="0" Height="26" Margin="0,0,6,0"
                          ItemsSource="{Binding ParameterNames}" SelectedItem="{Binding SelectedParameter}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Height="26" Margin="6,0,6,0"
                          ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}"/>
                <TextBox Grid.Row="1" Grid.Column="2" Height="24" Margin="6,0,6,0" VerticalContentAlignment="Center"
                         Style="{StaticResource VMTextBox}"
                         Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Grid.Row="1" Grid.Column="3" Content="Case" VerticalAlignment="Center" Margin="6,0,6,0"
                          IsChecked="{Binding CaseSensitive}"/>
                <Button Grid.Row="1" Grid.Column="4" Content="Apply" Width="80" Height="30"
                        Style="{StaticResource FlatButton}" Command="{Binding ApplyCommand}"/>
            </Grid>

            <!-- Preview -->
            <Border Grid.Row="2" Margin="12,6,12,6" BorderBrush="CornflowerBlue" BorderThickness="1" CornerRadius="3">
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          BorderThickness="0" Background="White" GridLinesVisibility="None"
                          RowHeaderWidth="0" HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#EDF2FB"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderBrush" Value="#DDEAFF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" SortMemberPath="Value" Width="*"/>
                        <DataGridTextColumn Header="Family and type" Binding="{Binding FamilyAndType}" SortMemberPath="FamilyAndType" Width="*"/>
                        <DataGridTextColumn Header="Data type" Binding="{Binding DataType}" SortMemberPath="DataType" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="3" BorderBrush="#DDEAFF" BorderThickness="0,1,0,0" Background="#F5F7FF">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"
                               Foreground="#888888" TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusMessage}"/>
                    <Button Grid.Column="1" Width="120" Height="30" VerticalAlignment="Center"
                            Content="Select &amp; Close" Style="{StaticResource FlatButton}" Command="{Binding CloseCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</common:ToolWindow>
