<Window x:Class="RevitClashDetectorUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RevitClashDetectorUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <TextBox Name="MessagesTextBox" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Margin="10,10,10,100"/>
        <StackPanel Orientation="Horizontal">

            <TextBox Name="MessageTextBox" Height="30" Width="500" VerticalAlignment="Bottom" Margin="10,10,10,10"/>
            <Button Content="Send" Width="80" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10" Click="SendMessageButton_Click"/>
            <Button Content="Run Clashes" Width="80" Height="30" Margin="10" Click="SendCommand" VerticalAlignment="Bottom"/>

        </StackPanel>
    </Grid>
</Window>
